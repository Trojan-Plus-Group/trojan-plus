{
    "run_type": "forward",
    "local_addr": "127.0.0.1",
    "local_port": 5901,
    "remote_addr": "example.com",
    "remote_port": 443,
    "target_addr": "127.0.0.1",
    "target_port": 5901,
    "password": [
        "password1"
    ],
    "udp_timeout": 60,
    "log_level": 1,
    "ssl": {
        "padding": true,
        "padding_bytes": 16384,
        "verify": true,
        "verify_hostname": true,
        "cert": "",
        "fingerprint": "chrome",
        "cipher": "",
        "cipher_tls13": "",
        "sni": "",
        "alpn": [
            "h2",
            "http/1.1"
        ],
        "reuse_session": true,
        "session_ticket": false,
        "curves": ""
    },
    "tcp": {
        "prefer_ipv4": false,
        "ipv6_only": false,
        "no_delay": true,
        "keep_alive": true,
        "reuse_port": false,
        "fast_open": false,
        "fast_open_qlen": 20
    },
    "experimental": {
        "pipeline_num": 0,
        "pipeline_timeout": 600,
        "pipeline_ack_window": 200,
        "pipeline_loadbalance_configs": [],
        "pipeline_proxy_icmp": false
    }
}
