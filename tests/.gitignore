# Allow config files in tests
!*.json
# Generated by fulltest_ipv6.py on each run. tests/.gitignore is read after
# the root ignore, so this must come after !*.json or the negation wins.
LinuxFullTest/config/ipv6_*.json
LinuxFullTest/html_ipv6/
*.tmp.json
*.tmp2.json
*.tmpb.json
*.tmpjson
_t*_aioquic_client.py
*.log
